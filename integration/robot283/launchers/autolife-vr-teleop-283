#!/usr/bin/env bash
set -e
WORKSPACE="/home/ubuntu/ros2_ws"

if [ ! -f /opt/ros/jazzy/setup.bash ]; then
  echo "未找到 ROS 2 Jazzy：/opt/ros/jazzy/setup.bash" >&2
  exit 2
fi
if [ ! -f "$WORKSPACE/install/setup.bash" ]; then
  echo "未找到300工作区：$WORKSPACE" >&2
  exit 3
fi

source /opt/ros/jazzy/setup.bash
source "$WORKSPACE/install/setup.bash"

export ROS_DOMAIN_ID=0
export ROBOT_ID=283
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# 默认真机模式；传 --dry-run 只做 WebXR/IK 预览（不动硬件）
DRY="false"
if [ "${1:-}" = "--dry-run" ]; then DRY="true"; fi

if ! ros2 pkg prefix openarmx_teleop_vr_306_v4 >/dev/null 2>&1; then
  echo "未找到 openarmx_teleop_vr_306_v4，请先编译工作区。" >&2
  exit 4
fi

exec ros2 launch openarmx_teleop_vr_306_v4 full_vr_teleop.launch.py \
  topic_suffix:=0_283 dry_run:=$DRY
